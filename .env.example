# Local development only. Replace both example passwords with the same value.
# URL-encode special characters in the password inside DATABASE_URL.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://eventflow:change-me@127.0.0.1:5432/eventflow
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
